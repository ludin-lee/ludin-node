{
  "name": "ludin-monorepo",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm --filter @ludin-docs/ui build && pnpm -r --filter './packages/*' --filter '!@ludin-docs/ui' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit -p tsconfig.json",
    "dev:express": "pnpm --filter example-express dev",
    "dev:nest": "pnpm --filter example-nest dev",
    "hash": "node packages/core/dist/cli.js hash"
  },
  "devDependencies": {
    "playwright": "1.47.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludin-lee/ludin-node.git"
  }
}
