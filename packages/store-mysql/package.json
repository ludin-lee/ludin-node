{
  "name": "@ludin/store-mysql",
  "version": "0.2.0",
  "description": "MySQL / MariaDB store for ludin – accounts, invites, sessions and audit log in your database.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": { "ludin": "workspace:*" },
  "peerDependencies": { "mysql2": ">=3.0.0" },
  "devDependencies": { "@types/node": "^22.0.0", "mysql2": "^3.11.0", "tsx": "^4.19.0" },
  "keywords": ["ludin", "openapi", "mysql", "mariadb", "store"]
}
