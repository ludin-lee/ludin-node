{
  "name": "@ludin-docs/nestjs",
  "version": "0.4.0",
  "description": "NestJS module for ludin – Swagger UI with login, accounts, IP allowlist and a themeable UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18"
  },
  "dependencies": {
    "@ludin-docs/core": "workspace:*",
    "@ludin-docs/express": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@nestjs/core": ">=9.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludin-lee/ludin-node.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/ludin-lee/ludin-node#readme",
  "bugs": {
    "url": "https://github.com/ludin-lee/ludin-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
