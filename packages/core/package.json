{
  "name": "@ludin-docs/core",
  "version": "0.3.2",
  "description": "Swagger UI, but with login, accounts, IP allowlist, audit log and a beautiful themeable UI. Framework-agnostic core.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ludin": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "peerDependencies": {
    "bcryptjs": ">=2.4.0",
    "argon2": ">=0.40.0"
  },
  "peerDependenciesMeta": {
    "bcryptjs": {
      "optional": true
    },
    "argon2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "keywords": [
    "openapi",
    "swagger",
    "api-docs",
    "documentation",
    "auth",
    "ip-allowlist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludin-lee/ludin-node.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ludin-lee/ludin-node#readme",
  "bugs": {
    "url": "https://github.com/ludin-lee/ludin-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
