{
  "name": "@ludin-docs/express",
  "version": "0.3.0",
  "description": "Express adapter for ludin – Swagger UI with login, accounts, IP allowlist and a themeable UI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18"
  },
  "dependencies": {
    "ludin": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=4.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "express": "^4.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludin-lee/ludin-node.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/ludin-lee/ludin-node#readme",
  "bugs": {
    "url": "https://github.com/ludin-lee/ludin-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
