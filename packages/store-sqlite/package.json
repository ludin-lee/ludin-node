{
  "name": "@ludin/store-sqlite",
  "version": "0.2.0",
  "description": "SQLite store for ludin \u2013 accounts, invites, sessions and audit log in a file.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target node18",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "ludin": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  },
  "keywords": [
    "ludin",
    "openapi",
    "sqlite",
    "store"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ludin-lee/ludin-node.git",
    "directory": "packages/store-sqlite"
  },
  "homepage": "https://github.com/ludin-lee/ludin-node#readme",
  "bugs": {
    "url": "https://github.com/ludin-lee/ludin-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
